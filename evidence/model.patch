+		"small.json": `{"name":"small"}
+`,
+	}
+	param := &testcmd.ParamTest{
+		FilePaths:    []string{"hello_test.jsonnet"},
+		MaxDataBytes: "100",
+	}
+	out, err := runTest(t, files, param)
+	if err == nil {
+		t.Fatal("the command must fail")
+	}
+	if !strings.Contains(out, "Test Name: oversize") {
